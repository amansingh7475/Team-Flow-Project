NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/teamflow
FRONTEND_ORIGIN=http://localhost:5173
API_RATE_LIMIT=120
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
# Optional for integration tests; otherwise mongodb-memory-server is attempted.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/teamflow_test
INVITATION_DELIVERY_URL=
SOCKET_CORS_ORIGIN=http://localhost:5173
